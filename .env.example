# Copy this file to `.env` (same folder) and fill in your key.
# `.env` is gitignored. Never commit a real key.

# Required for LIVE agents. Without it the system still runs end to end, but the
# five agents emit deterministic text derived from computed fleet state, and the
# dashboard labels every card "simulated" rather than passing it off as live.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
#
# COST: a full 6-role incident measures ~6,120 input + ~1,500 output tokens.
#   claude-opus-5      ~$0.068 per incident   (~73 runs per $5)
#   claude-sonnet-5    ~$0.041 per incident  (~122 runs per $5)
#   claude-haiku-4-5   ~$0.014 per incident  (~367 runs per $5)
#
# Haiku is 5x cheaper and comfortably handles these turns — every number is
# pre-computed by the models, so each agent only writes 1-2 sentences. It is the
# sensible choice for testing and rehearsals. Note it has no `effort` parameter;
# the code detects that and omits it automatically.
# AUTOFLEET_MODEL=claude-haiku-4-5
#
# AUTOFLEET_EFFORT=low          # low | medium | high | xhigh | max (ignored on Haiku)
# AUTOFLEET_TIMEOUT=25          # seconds per model call
# AUTOFLEET_CHAIN_BUDGET=45     # seconds for a whole incident
