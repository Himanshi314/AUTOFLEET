# Copy this file to `.env` (same folder) and fill in your key.
# `.env` is gitignored. Never commit a real key.

# Required for LIVE agents. Without it the system still runs end to end, but the
# five agents emit deterministic text derived from computed fleet state, and the
# dashboard labels every card "simulated" rather than passing it off as live.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
# AUTOFLEET_MODEL=claude-opus-5
# AUTOFLEET_EFFORT=low          # low | medium | high | xhigh | max
