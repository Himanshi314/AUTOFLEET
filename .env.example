# Copy this file to `.env` (same folder) and fill in ONE provider.
# `.env` is gitignored. Never commit a real key.
#
# Check your setup before a demo:   python -m autofleet.llm

# ---------------------------------------------------------------------------
# Pick a provider. Without a key the system still runs end to end — the agents
# emit deterministic text derived from computed fleet state and the dashboard
# labels every card "simulated" rather than passing it off as live.
# ---------------------------------------------------------------------------
AUTOFLEET_PROVIDER=anthropic        # anthropic | groq

# --- Option A: Anthropic (paid, no free tier) -------------------------------
ANTHROPIC_API_KEY=sk-ant-...
#
# Measured cost per full 6-role incident (~6,120 in + ~1,500 out tokens):
#   claude-opus-5      ~$0.068   (~73 runs per $5)
#   claude-sonnet-5    ~$0.041  (~122 runs per $5)
#   claude-haiku-4-5   ~$0.014  (~367 runs per $5)
#
# Haiku handles these turns comfortably — every number is pre-computed, so each
# agent writes 1-2 sentences. ~Rs 150 covers testing plus all rehearsals.
# It has no `effort` parameter; the code detects that and omits it.
# AUTOFLEET_MODEL=claude-haiku-4-5

# --- Option B: Groq (has a free tier; needs no pip install) -----------------
# Set AUTOFLEET_PROVIDER=groq above, then:
# GROQ_API_KEY=gsk_...
#
# The Groq adapter speaks the OpenAI-compatible API over stdlib urllib, so it
# needs no extra package at all. Model ids change — if you get a 404, check
# console.groq.com/docs/models and set AUTOFLEET_MODEL.
# AUTOFLEET_MODEL=llama-3.3-70b-versatile

# --- Shared tuning ---------------------------------------------------------
# AUTOFLEET_EFFORT=low          # Anthropic only; ignored where unsupported
# AUTOFLEET_TIMEOUT=25          # seconds per model call
# AUTOFLEET_CHAIN_BUDGET=45     # seconds for a whole incident
